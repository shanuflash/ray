+bool (*g_ray_linux_frameless_app)(const std::string& app_name) = nullptr;
+
+bool RayLinuxFramelessApp(const BrowserWindowInterface* browser);
+
+bool RayLinuxFramelessApp(const BrowserWindowInterface* browser) {
+  if (!g_ray_linux_frameless_app || !browser ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_APP) {
+    return false;
+  }
+  const BrowserInitState* init = BrowserInitState::From(browser);
+  return init && g_ray_linux_frameless_app(init->create_params().app_name);
+}
 
