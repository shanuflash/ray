+TEST(SchedulerStateMachineTest, MainFrameThrottlingWaitsOneSecondAfterCreation) {
+  base::test::ScopedFeatureList scoped_feature_list_{
+      features::kThrottleMainFrameTo60Hz};
+
+  SchedulerSettings default_scheduler_settings;
+  StateMachine state(default_scheduler_settings);
+  SET_UP_STATE(state);
+
+  state.FrameIntervalUpdated(base::Hertz(120));
+  state.AdvanceTimeBy(base::Seconds(1280));
+
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 10);
+  state.AdvanceTimeBy(base::Milliseconds(800));
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 10);
+  state.AdvanceTimeBy(base::Milliseconds(200));
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 5);
+}
+
+TEST(SchedulerStateMachineTest, MainFrameThrottlingWaitsOneSecondAfterShow) {
+  base::test::ScopedFeatureList scoped_feature_list_{
+      features::kThrottleMainFrameTo60Hz};
+
+  SchedulerSettings default_scheduler_settings;
+  StateMachine state(default_scheduler_settings);
+  SET_UP_STATE(state);
+
+  state.FrameIntervalUpdated(base::Hertz(120));
+  state.AdvanceTimeBy(base::Seconds(1280));
+  ExpireMainFrameThrottleGrace(state);
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 5);
+
+  state.SetVisible(false);
+  state.AdvanceTimeBy(base::Seconds(5));
+  state.SetVisible(true);
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 10);
+  state.AdvanceTimeBy(base::Seconds(1));
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 5);
 }
 
+TEST(SchedulerStateMachineTest,
+     MainFrameThrottlingGraceRestartsWhenShownAgainWithinOneSecond) {
+  base::test::ScopedFeatureList scoped_feature_list_{
+      features::kThrottleMainFrameTo60Hz};
+
+  SchedulerSettings default_scheduler_settings;
+  StateMachine state(default_scheduler_settings);
+  SET_UP_STATE(state);
+
+  state.FrameIntervalUpdated(base::Hertz(120));
+  state.AdvanceTimeBy(base::Seconds(1280));
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 10);
+  state.AdvanceTimeBy(base::Milliseconds(500));
+
+  state.SetVisible(false);
+  state.SetVisible(true);
+  state.AdvanceTimeBy(base::Milliseconds(100));
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 10);
+  state.AdvanceTimeBy(base::Milliseconds(700));
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 10);
+  state.AdvanceTimeBy(base::Milliseconds(300));
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 5);
+}
