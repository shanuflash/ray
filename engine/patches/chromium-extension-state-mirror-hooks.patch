+RulesMonitorService::ApiCallback RayNotifyingRulesChanged(
+    content::BrowserContext* context,
+    const ExtensionId& extension_id,
+    const char* kind,
+    RulesMonitorService::ApiCallback callback) {
+  if (!g_ray_dnr_rules_changed) {
+    return callback;
+  }
+  return base::BindOnce(
+      [](base::WeakPtr<content::BrowserContext> context,
+         const ExtensionId& extension_id, const std::string& kind,
+         RulesMonitorService::ApiCallback callback,
+         std::optional<std::string> error) {
+        const bool changed = !error.has_value();
+        std::move(callback).Run(std::move(error));
+        if (changed && context && g_ray_dnr_rules_changed) {
+          g_ray_dnr_rules_changed(context.get(), extension_id, kind);
+        }
+      },
+      context->GetWeakPtr(), extension_id, std::string(kind),
+      std::move(callback));
+}
