+bool UnloadController::DeferLinuxClose(ray::LinuxCloseStage stage,
+                                       base::OnceClosure resume) {
+  return ray::GateLinuxClose(
+      browser_, stage,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser,
+             ray::LinuxCloseStage stage, base::OnceClosure resume,
+             bool proceed) {
+            if (!browser) {
+              return;
+            }
+            if (!proceed) {
+              if (ray::CanCancelLinuxClose(browser.get())) {
+                UnloadController::From(browser.get())->CancelWindowClose();
+              }
+              return;
+            }
+            auto* controller = UnloadController::From(browser.get());
+            if (stage != ray::LinuxCloseStage::kPrepare &&
+                ray::CanCancelLinuxClose(browser.get()) &&
+                !controller->IsLinuxClosePreflightReady()) {
+              controller->linux_window_close_requested_ = true;
+              if (controller->is_attempting_to_close_browser()) {
+                controller->ProcessPendingTabs(false);
+              } else {
+                controller->HandleBeforeClose();
+              }
+              return;
+            }
+            std::move(resume).Run();
+          },
+          browser_->GetWeakPtr(), stage, std::move(resume)),
+      base::BindRepeating(
+          [](base::WeakPtr<BrowserWindowInterface> browser) {
+            return browser && UnloadController::From(browser.get())
+                                  ->IsLinuxClosePreflightReady();
+          },
+          browser_->GetWeakPtr()));
+}
