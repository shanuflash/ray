+TEST(SchedulerStateMachineTest, MainFrameThrottlingWaitsOneSecondAfterInput) {
+  base::test::ScopedFeatureList scoped_feature_list_{
+      features::kThrottleMainFrameTo60Hz};
+
+  SchedulerSettings default_scheduler_settings;
+  StateMachine state(default_scheduler_settings);
+  SET_UP_STATE(state);
 
+  state.FrameIntervalUpdated(base::Hertz(120));
+  state.AdvanceTimeBy(base::Seconds(1280));
+  ExpireMainFrameThrottleGrace(state);
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 5);
+
+  state.NotifyInputEvent(state.Now());
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 10);
+  state.AdvanceTimeBy(base::Milliseconds(800));
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 10);
+  state.AdvanceTimeBy(base::Milliseconds(200));
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 5);
+}
+
+TEST(SchedulerStateMachineTest,
+     MainFrameThrottlingInputDuringAFrameCountsFromThatFrame) {
+  base::test::ScopedFeatureList scoped_feature_list_{
+      features::kThrottleMainFrameTo60Hz};
+
+  SchedulerSettings default_scheduler_settings;
+  StateMachine state(default_scheduler_settings);
+  SET_UP_STATE(state);
+
+  state.FrameIntervalUpdated(base::Hertz(120));
+  state.AdvanceTimeBy(base::Seconds(1280));
+  ExpireMainFrameThrottleGrace(state);
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 5);
+
+  bool sent = false;
+  for (int i = 0; i < 2 && !sent; i++) {
+    state.SetNeedsBeginMainFrame(false);
+    sent = RunOneFrameAndReturnWhetherMainFrameIsIssued(state);
+    state.AdvanceTimeBy(base::Hertz(120));
+  }
+  EXPECT_TRUE(sent);
+  state.SetNeedsBeginMainFrame(false);
+  state.IssueNextBeginImplFrame();
+  EXPECT_TRUE(state.ShouldThrottleSendBeginMainFrame());
+  state.NotifyInputEvent(state.Now());
+  EXPECT_FALSE(state.ShouldThrottleSendBeginMainFrame());
+
+  state.OnBeginImplFrameDeadline();
+  state.OnBeginImplFrameIdle();
+  state.AdvanceTimeBy(base::Milliseconds(1100));
+  EXPECT_EQ(CountMainFramesIn120HzFrames(state, 10), 5);
+}
+
