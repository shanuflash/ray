+bool ExternalBeginFrameSourceMac::CanWarmUp() const {
+  return g_ray_begin_frame_bridge && display_link_mac_ &&
+         vsync_subsampling_factor_ == 1;
+}
+
+void ExternalBeginFrameSourceMac::ScheduleWarmUpBeginFrame() {
+  if (!CanWarmUp() || !needs_begin_frames_ || !awaiting_first_vsync_ ||
+      warm_up_frames_ >= kRayMaxWarmUpFrames || warm_up_timer_.IsRunning()) {
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const RayVSyncGrid* grid =
+      RayFreshVSyncGrid(display_id_, min_refresh_interval_, now);
+  if (!grid) {
+    return;
+  }
+  base::TimeTicks next = now.SnappedToNextTick(grid->timebase, grid->interval);
+  while (next <= now || (last_begin_frame_args_.IsValid() &&
+                         next <= last_begin_frame_args_.frame_time)) {
+    next += grid->interval;
+  }
+  warm_up_timer_.Start(FROM_HERE, next - now, this,
+                       &ExternalBeginFrameSourceMac::OnWarmUpBeginFrame);
+}
+
+void ExternalBeginFrameSourceMac::OnWarmUpBeginFrame() {
+  if (!CanWarmUp() || !awaiting_first_vsync_ || !needs_begin_frames_) {
+    return;
+  }
+  ++warm_up_frames_;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const RayVSyncGrid* grid =
+      RayFreshVSyncGrid(display_id_, min_refresh_interval_, now);
+  if (!grid) {
+    return;
+  }
+  const base::TimeDelta interval = grid->interval;
+  const base::TimeTicks frame_time =
+      now.SnappedToNextTick(grid->timebase, interval) - interval;
+  if (last_begin_frame_args_.IsValid() &&
+      frame_time <= last_begin_frame_args_.frame_time) {
+    ScheduleWarmUpBeginFrame();
+    return;
+  }
+  TRACE_EVENT_INSTANT("viz",
+                      "ExternalBeginFrameSourceMac::OnWarmUpBeginFrame");
+  OnBeginFrame(begin_frame_args_generator_.GenerateBeginFrameArgs(
+      source_id(), frame_time, frame_time + interval, interval,
+      min_refresh_interval_));
+  warmed_up_by_timer_ = true;
+  last_frame_time_ = frame_time;
+  last_interval_ = interval;
+  ScheduleWarmUpBeginFrame();
+}
