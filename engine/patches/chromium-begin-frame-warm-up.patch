+struct RayVSyncGrid {
+  base::TimeTicks timebase;
+  base::TimeDelta interval;
+  base::TimeTicks recorded_at;
+};
+
+constexpr int kRayMaxWarmUpFrames = 4;
+constexpr base::TimeDelta kRayVSyncGridLifetime = base::Seconds(2);
+constexpr base::TimeDelta kRayVSyncGridTolerance = base::Microseconds(500);
+
+base::flat_map<int64_t, RayVSyncGrid>& RayVSyncGrids() {
+  static base::NoDestructor<base::flat_map<int64_t, RayVSyncGrid>> grids;
+  return *grids;
+}
+
+const RayVSyncGrid* RayFreshVSyncGrid(int64_t display_id,
+                                          base::TimeDelta expected_interval,
+                                          base::TimeTicks now) {
+  auto found = RayVSyncGrids().find(display_id);
+  if (found == RayVSyncGrids().end()) {
+    return nullptr;
+  }
+  const RayVSyncGrid& grid = found->second;
+  if (now - grid.recorded_at > kRayVSyncGridLifetime ||
+      (grid.interval - expected_interval).magnitude() >
+          kRayVSyncGridTolerance) {
+    return nullptr;
+  }
+  return &grid;
+}
 
