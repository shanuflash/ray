Native messaging starts Apple Passwords' helper (com.apple.passwordmanager) only for a browser that holds
com.apple.developer.web-browser.public-key-credential. The helper's parent launch constraint accepts any parent with
that entitlement, alongside its list of known browsers, and kills it at exec under any other parent (SIGKILL, Code
Signature Invalid), which left a PasswordManagerBrowserExtensionHelper crash report at every connectNative of the
iCloud Passwords extension. Ray's release is signed with the entitlement once its Developer ID profile grants it;
Debug, train and ad hoc builds are not, so FindManifest keeps answering "Can't find native messaging host" for the
helper there, from any directory, including Chrome's, which Helium's scan-chrome-native-messaging-hosts reads.

--- a/chrome/browser/extensions/api/messaging/launch_context_posix.cc
+++ b/chrome/browser/extensions/api/messaging/launch_context_posix.cc
@@ -20,10 +20,37 @@
 #include "chrome/common/chrome_paths.h"
 #include "net/base/file_stream.h"
 
+#if BUILDFLAG(IS_MAC)
+#include <Security/Security.h>
+
+#include "base/apple/scoped_cftyperef.h"
+#endif
+
 namespace extensions {
 
 namespace {
 
+#if BUILDFLAG(IS_MAC)
+constexpr char kAppleLaunchConstrainedHost[] = "com.apple.passwordmanager";
+
+bool BrowserMayStartAppleLaunchConstrainedHost() {
+  static const bool entitled = [] {
+    base::apple::ScopedCFTypeRef<SecTaskRef> task(
+        SecTaskCreateFromSelf(nullptr));
+    if (!task) {
+      return false;
+    }
+    base::apple::ScopedCFTypeRef<CFTypeRef> value(
+        SecTaskCopyValueForEntitlement(
+            task.get(),
+            CFSTR("com.apple.developer.web-browser.public-key-credential"),
+            nullptr));
+    return value && CFEqual(value.get(), kCFBooleanTrue);
+  }();
+  return entitled;
+}
+#endif
+
